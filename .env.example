# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────────────────────
# (no credentials needed for the default Redis setup)

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_DEFAULT_BUCKET=confidence-gate-artifacts

# ── Auth provider ─────────────────────────────────────────────────────────────
# "firebase" (default) or "local" (dev-only JWT, no Firebase required)
AUTH_PROVIDER=firebase

# Firebase — required when AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-firebase-project-id

# Local JWT — required when AUTH_PROVIDER=local
LOCAL_AUTH_SECRET=change-me-in-production

# ── AI provider ───────────────────────────────────────────────────────────────
# "openai" (default), "anthropic", or "ollama"
AI_PROVIDER=openai

# OpenAI — required when AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Anthropic — required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama — required when AI_PROVIDER=ollama (run ollama locally or in Docker)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Frontend (Firebase) ───────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_API_URL=http://localhost:8001
